<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.kursinis.fxControllers.OrderForm"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Užsakymo forma" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="Pavadinimas:" prefWidth="120"/>
        <TextField fx:id="txtName" promptText="pvz. Pietūs"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Kaina:" prefWidth="120"/>
        <TextField fx:id="txtPrice" promptText="pvz. 12.50"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Pirkėjas:" prefWidth="120"/>
        <ComboBox fx:id="cmbBuyer" prefWidth="220"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Restoranas:" prefWidth="120"/>
        <ComboBox fx:id="cmbRestaurant" prefWidth="220"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Vairuotojas:" prefWidth="120"/>
        <ComboBox fx:id="cmbDriver" prefWidth="220"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Statusas:" prefWidth="120"/>
        <ComboBox fx:id="cmbStatus" prefWidth="220"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Patiekalai:" prefWidth="120"/>
        <!-- kol kas demo, vėliau galima pakeisti į realius Cuisine -->
        <ListView fx:id="listCuisine" prefHeight="120"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Išsaugoti" onAction="#onSave"/>
        <Button text="Atšaukti" onAction="#onCancel"/>
    </HBox>

    <Label fx:id="lblError" textFill="red"/>

</VBox>
